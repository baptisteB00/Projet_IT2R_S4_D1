import sensor, image, lcd
import KPU as kpu

lcd.init()
sensor.reset()
sensor.set_pixformat(sensor.RGB565)
sensor.set_framesize(sensor.QVGA)
sensor.run(1)
sensor.set_windowing((320,240))  # Ajout HD pour redimensionner les images du capteur

modele = kpu.load(0x300000)
anchors = [3.06, 3.0, 4.05, 3.84, 1.47, 1.52, 2.31, 2.22, 0.88, 0.89]
kpu.init_yolo2(modele, 0.5, 0.3, 5, anchors)

while True:
        img = sensor.snapshot()
        Resultats = kpu.run_yolo2(modele, img)
        if Resultats :
            for i in Resultats :
                print(i)
                img.draw_rectangle(i.rect(),color=(255,0,0))
                img.draw_string(i.x(), i.y(), str(int((i.value())*100)) + " % STOP!", lcd.RED, scale=2)
        lcd.display(img)
