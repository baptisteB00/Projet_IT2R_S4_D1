import sensor, image, lcd
import KPU as kpu


#---------- Initialisation LCD et Caméra -----------
lcd.init()
sensor.reset()
sensor.set_pixformat(sensor.RGB565)
sensor.set_framesize(sensor.QVGA)
sensor.run(1)

#---------- Initialisation KPU avec le modèle IA entrainé au préalable -------------------------

modele = kpu.load(0x300000)   # Chargement des coefficients du modèle depuis l'adresse 0x300000
anchors = (1.08, 1.19, 3.42, 4.41, 6.63, 11.38, 9.42, 5.11, 16.62, 10.52)  # Ancrage zones image
kpu.init_yolo2(modele, 0.5, 0.3, 5, anchors) # Initialisation du calculateur IA


#-------- Définition labels des images ---------------------------------------------------------
classes = ['stop', 'speedlimit', 'trafficlight', 'crosswalk']

while True:
        img = sensor.snapshot()  # Capture d'une image
        Resultats = kpu.run_yolo2(modele, img)  # Récupération du résultat du calculateur IA
        if Resultats :
            for i in (0,2) :  # il peut y avoir plusieurs identifications
                img.draw_rectangle(i.rect(),color=(0,255,0)) # Sur LCD, tracé de la boite englobante
                print(i , "  ", classes[i.classid()] )    # Sur terminal série, affichage du contenu de chaque résultat + Classe de l'objet
        lcd.display(img)

